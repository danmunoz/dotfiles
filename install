#!/usr/bin/env bash

set -Eeuo pipefail

REPO_URL="${DOTFILES_REPO_URL:-https://github.com/danmunoz/dotfiles.git}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEFAULT_REPO_DIR="$HOME/Repos/dotfiles"

if [[ -d "$SCRIPT_DIR/.git" ]] && [[ -x "$SCRIPT_DIR/bootstrap/main.sh" ]]; then
  REPO_DIR="$SCRIPT_DIR"
else
  REPO_DIR="${DOTFILES_REPO_DIR:-$DEFAULT_REPO_DIR}"
fi

die() {
  printf "error: %s\n" "$1" >&2
  exit 1
}

info() {
  printf "==> %s\n" "$1"
}

is_dry_run() {
  [[ "${DRY_RUN:-0}" == "1" ]]
}

run() {
  is_dry_run && return 0
  "$@"
}

parse_args() {
  for arg in "$@"; do
    case "$arg" in
      -n|--dry-run)
        export DRY_RUN=1
        ;;
      -h|--help)
        printf "Usage: %s [OPTIONS]\n\n" "$0"
        printf "Options:\n"
        printf "  -n, --dry-run    Simulate setup actions without modifying system or files\n"
        printf "  -h, --help       Show this help message\n"
        exit 0
        ;;
      *)
        die "Unknown argument: $arg"
        ;;
    esac
  done
}

ensure_apple_silicon_macos() {
  [[ "$(uname -s)" == "Darwin" ]] || die "This bootstrap only supports macOS."
  [[ "$(uname -m)" == "arm64" ]] || die "This bootstrap only supports Apple Silicon Macs."
}

ensure_command_line_tools() {
  if xcode-select -p >/dev/null 2>&1; then
    return 0
  fi

  info "Apple Command Line Tools are required."
  is_dry_run && return 0
  xcode-select --install || true
  printf "Complete the Command Line Tools installer, then press Return to continue."
  read -r _
  xcode-select -p >/dev/null 2>&1 || die "Command Line Tools are still unavailable."
}

setup_homebrew() {
  if ! command -v brew >/dev/null 2>&1; then
    info "Installing Homebrew."
    run /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  fi

  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif ! is_dry_run; then
    die "Homebrew was not found at /opt/homebrew/bin/brew."
  fi
}

install_bootstrap_tools() {
  info "Installing bootstrap tools from bootstrap/Brewfile.bootstrap."
  run brew bundle --file="$REPO_DIR/bootstrap/Brewfile.bootstrap"
}

load_bootstrap_checks() {
  local checks_file="$REPO_DIR/bootstrap/lib/checks.sh"

  [[ -r "$checks_file" ]] || die "Bootstrap checks missing: $checks_file"
  # shellcheck source=bootstrap/lib/checks.sh
  source "$checks_file"
}

ensure_repo_clone() {
  if [[ -d "$REPO_DIR/.git" ]]; then
    info "Updating existing dotfiles clone."
    run git -C "$REPO_DIR" fetch origin
    run git -C "$REPO_DIR" pull --ff-only
    return 0
  fi

  if [[ -e "$REPO_DIR" ]]; then
    die "$REPO_DIR exists but is not a git clone."
  fi

  info "Cloning dotfiles to $REPO_DIR."
  run mkdir -p "$(dirname "$REPO_DIR")"
  run git clone "$REPO_URL" "$REPO_DIR"
}

main() {
  parse_args "$@"

  ensure_apple_silicon_macos
  ensure_command_line_tools
  ensure_repo_clone

  # Homebrew's non-interactive installer cannot prompt for sudo. Authenticate
  # before launching it, while this bootstrap can still ask the user directly.
  load_bootstrap_checks
  ensure_sudo_access
  setup_homebrew
  install_bootstrap_tools

  [[ -x "$REPO_DIR/bootstrap/main.sh" ]] || die "Bootstrap entrypoint missing: $REPO_DIR/bootstrap/main.sh"
  exec "$REPO_DIR/bootstrap/main.sh" "$@"
}

main "$@"
